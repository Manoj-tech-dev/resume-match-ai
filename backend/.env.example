# ---------------------------------------------------------------
# AI Resume Analyzer — backend configuration
# Copy this file to `.env` and adjust. Never commit `.env`.
# ---------------------------------------------------------------

# General
APP_ENV=development
LOG_LEVEL=INFO

# Comma-separated list of allowed frontend origins (CORS)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database (SQLAlchemy URL). SQLite for dev; for Postgres use e.g.
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/resume_analyzer
DATABASE_URL=sqlite:///./data/resume_analyzer.db

# Upload limits
MAX_UPLOAD_SIZE_MB=5
MAX_JOB_DESCRIPTION_CHARS=20000

# ---------------------------------------------------------------
# LLM provider: one of `auto`, `mock`, `openai`, `gemini`
#   auto -> uses OpenAI if OPENAI_API_KEY is set, else Gemini if
#           GEMINI_API_KEY is set, else the local mock provider.
# ---------------------------------------------------------------
LLM_PROVIDER=auto
LLM_TIMEOUT_SECONDS=60
LLM_TEMPERATURE=0.2

# OpenAI (or any OpenAI-compatible endpoint)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
